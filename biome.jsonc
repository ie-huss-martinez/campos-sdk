{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!pnpm-lock.yaml", "!.changeset/*.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  // Prose and tables stay hand-formatted: padded tables turn a one-cell edit
  // into a whole-table diff.
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Conflicts with tsconfig's noPropertyAccessFromIndexSignature.
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useConst": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      // The library's own code: no platform imports, no clock and no
      // randomness (ADR 0002). tsconfig.json already rejects platform globals.
      "includes": ["src/**", "!src/**/*.test.ts"],
      "plugins": ["./biome/no-impure-calls.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "Library code in src/ uses no platform API (ADR 0002)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
